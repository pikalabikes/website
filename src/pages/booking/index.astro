---
import Layout from "../../layouts/default.astro";
import Header from "../../components/header.astro";
import Button from "../../components/button.astro";
import BookingOptions from "../../components/booking/options.astro";

import { frontmatter as config } from "../../../admin/pages/booking/booking.mdx";

const tours = Object.values(
  import.meta.glob("../../../admin/pages/booking/tours/*.mdx", { eager: true }),
);
// ====== FIXED CHANGE 1: Safe city filtering with automatic fallback ======
const allRental = Object.values(
  import.meta.glob("../../../admin/pages/booking/rental/*.mdx", { eager: true }),
);

// Fallback: If a bike has no city tag, default it to 'marrakech' so it never goes blank
const marrakechBikes = allRental.filter(bike => {
  const city = bike.frontmatter.city?.toLowerCase().trim();
  return city === 'marrakech' || !city;
});

const agadirBikes = allRental.filter(bike => {
  return bike.frontmatter.city?.toLowerCase().trim() === 'agadir';
});
// =========================================================================
---

<Layout pageTitle="Bookings" gtags={["AW-16465322938"]}>
  <Header cafe border />
  <div id="booking" class="booking">
    <aside class="booking-intro">
      <h2>I'd like to</h2>
      <nav class="booking-types">
        <Button
          class="booking-options-toggle"
          size="l"
          variant="outline"
          aria-controls="tours"
          aria-haspopup="true"
          aria-expanded="true"
        >
          Book a tour
        </Button>
        <Button
          class="booking-options-toggle"
          size="l"
          variant="outline"
          aria-controls="bike-rental"
          aria-haspopup="true"
        >
          Rent a bike
        </Button>
      </nav>
    </aside>
    <main class="booking-main">
      <BookingOptions
        id="tours"
        description={config["tours_description"]}
        items={tours}
        type="tour"
        preselected
      />
     {/* ====== FIXED CHANGE 2: Removed 'hidden' so the script can unhide it ====== */}
      <div id="bike-rental">
        <p class="rental-description" style="margin-bottom: 1.5rem;">{config["rental_description"]}</p>
        
        <div class="city-switcher">
          <button class="city-btn active" data-target="marrakech-bikes">Marrakech</button>
          <button class="city-btn" data-target="agadir-bikes">Agadir</button>
        </div>

        <div id="marrakech-bikes" class="city-pane">
          <BookingOptions
            id="marrakech-rental-options"
            items={marrakechBikes}
            type="bikes"
          />
        </div>

        <div id="agadir-bikes" class="city-pane" style="display: none;">
          <BookingOptions
            id="agadir-rental-options"
            items={agadirBikes}
            type="bikes"
          />
        </div>
      </div>
      {/* ====== END OF UPDATED CHANGE 2 ====== */}
    </main>
  </div>
</Layout>

<script>
  import setupBookingSelectable from "../../components/booking/booking-selectable";

  // 1. Keeps your sidebar tabs from breaking
  setupBookingSelectable({
    container: document.getElementById("booking"),
    optionsClass: "booking-intro",
    selectedClass: "booking-options-selected",
    toggleClass: "booking-options-toggle",
  });

  // ====== NEW FIX START: Force both inner bike components to wake up ======
  const wakeUpInnerBikes = () => {
    document.getElementById("marrakech-rental-options")?.classList.add("booking-options-selected");
    document.getElementById("agadir-rental-options")?.classList.add("booking-options-selected");
  };
  
  // Run this activation immediately when the page loads
  wakeUpInnerBikes();
  // ====== NEW FIX END ======

  // 2. Swaps visibility between Marrakech and Agadir panes
  const cityButtons = document.querySelectorAll('.city-btn');
  const cityPanes = document.querySelectorAll('.city-pane');

  cityButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      cityButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      cityPanes.forEach(pane => {
        if (pane.id === targetId) {
          (pane as HTMLElement).style.display = 'block';
        } else {
          (pane as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style lang="scss">
  @import "../../styles/breakpoints";
 // ====== FIXED CHANGE 4: Added layout controls to prevent page leaks ======
  #bike-rental {
    display: none; // 1. Keeps the bike section completely hidden by default

    &.booking-options-selected {
      display: block; // 2. Only reveals the section when "Rent a bike" is clicked
    }
  }

  .city-switcher {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
    
    .city-btn {
      padding: 0.6rem 2rem;
      border-radius: 25px;
      border: 2px solid var(--color-henna, #4a231a);
      background: transparent;
      font-weight: bold;
      cursor: pointer;
      font-size: 1.1rem;
      transition: all 0.2s ease;

      &.active {
        background: var(--color-henna, #4a231a);
        color: white;
      }
    }
  }
  // ====== CHANGE 4 END ======
  .booking {
    width: 100vw;
    overflow: hidden;
    min-height: 100vh;

    @include b-tablet {
      display: grid;
      grid: 1fr / 224px 1fr;
      gap: 3rem;
    }

    @include b-desktop {
      grid: 1fr / 280px 1fr;
    }

    @include b-large-desktop {
      grid: 1fr / 300px 1fr;
      gap: 6rem;
    }
  }

  .booking-intro {
    background: var(--color-marble);
    padding: 2rem 1rem 2rem;
    position: relative;

    @include b-tablet {
      padding: 3rem 1rem 2rem 2rem;

      &::before {
        content: "";
        display: block;
        position: absolute;
        background: inherit;
        top: -1rem;
        bottom: -1rem;
        clip-path: url(#wave6);
        width: 3rem;
        height: calc(100% + 1rem);
        left: auto;
        right: calc(-3rem + 1px);
      }
    }
  }

  .booking-types {
    scroll-margin-top: 1rem;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;

    @include b-desktop {
      gap: 1rem;
    }
  }

  .booking-options-toggle {
    &[aria-expanded="true"] {
      background-color: var(--color-henna);
      color: var(--color-marble);
    }
  }

  .booking-main {
    width: 100%;
    padding-bottom: 2rem;

    @include b-desktop {
      padding-top: 1.5rem;
    }
  }

  .booking-form {
    border: none;
  }
</style>
