---
import Layout from "../../layouts/default.astro";
import Header from "../../components/header.astro";
import Button from "../../components/button.astro";
import BookingOptions from "../../components/booking/options.astro";

import { frontmatter as config } from "../../../admin/pages/booking/booking.mdx";

const tours = Object.values(
  import.meta.glob("../../../admin/pages/booking/tours/*.mdx", { eager: true }),
);
// ====== CHANGE 1 START: Split the 8 rental files into two city lists ======
const allRental = Object.values(
  import.meta.glob("../../../admin/pages/booking/rental/*.mdx", { eager: true }),
);

// Filters the files automatically based on the 'city' tag you added
const marrakechBikes = allRental.filter(bike => bike.frontmatter.city === 'marrakech');
const agadirBikes = allRental.filter(bike => bike.frontmatter.city === 'agadir');
// ====== CHANGE 1 END ======
---

<Layout pageTitle="Bookings" gtags={["AW-16465322938"]}>
  <Header cafe border />
  <div id="booking" class="booking">
    <aside class="booking-intro">
      <h2>I'd like to</h2>
      <nav class="booking-types">
        <Button
          class="booking-options-toggle"
          size="l"
          variant="outline"
          aria-controls="tours"
          aria-haspopup="true"
          aria-expanded="true"
        >
          Book a tour
        </Button>
        <Button
          class="booking-options-toggle"
          size="l"
          variant="outline"
          aria-controls="bike-rental"
          aria-haspopup="true"
        >
          Rent a bike
        </Button>
      </nav>
    </aside>
    <main class="booking-main">
      <BookingOptions
        id="tours"
        description={config["tours_description"]}
        items={tours}
        type="tour"
        preselected
      />
    {/* ====== CHANGE 2 START: Wrapped in a container with city toggles and separate content panes ====== */}
      <div id="bike-rental" hidden>
        <p class="rental-description" style="margin-bottom: 1.5rem;">{config["rental_description"]}</p>
        
        <div class="city-switcher">
          <button class="city-btn active" data-target="marrakech-bikes">Marrakech</button>
          <button class="city-btn" data-target="agadir-bikes">Agadir</button>
        </div>

        <div id="marrakech-bikes" class="city-pane">
          <BookingOptions
            items={marrakechBikes}
            type="bikes"
          />
        </div>

        <div id="agadir-bikes" class="city-pane" style="display: none;">
          <BookingOptions
            items={agadirBikes}
            type="bikes"
          />
        </div>
      </div>
      {/* ====== CHANGE 2 END ====== */}
    </main>
  </div>
</Layout>

<script>
  import setupBookingSelectable from "../../components/booking/booking-selectable";

  setupBookingSelectable({
    container: document.getElementById("booking"),
    optionsClass: "booking-intro",
    selectedClass: "booking-options-selected",
    toggleClass: "booking-options-toggle",
  });
// ====== CHANGE 3 START: JavaScript logic to handle switching cities on click ======
  const cityButtons = document.querySelectorAll('.city-btn');
  const cityPanes = document.querySelectorAll('.city-pane');

  cityButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      // 1. Swap the active color on the buttons
      cityButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // 2. Hide the current city pile and show the selected city pile
      cityPanes.forEach(pane => {
        if (pane.id === targetId) {
          (pane as HTMLElement).style.display = 'block';
        } else {
          (pane as HTMLElement).style.display = 'none';
        }
      });
    });
  });
  // ====== CHANGE 3 END ======
</script>

<style lang="scss">
  @import "../../styles/breakpoints";
  // ====== CHANGE 4 START: Styling rounded custom city buttons ======
  .city-switcher {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
    
    .city-btn {
      padding: 0.6rem 2rem;
      border-radius: 25px;
      border: 2px solid var(--color-henna, #4a231a);
      background: transparent;
      font-weight: bold;
      cursor: pointer;
      font-size: 1.1rem;
      transition: all 0.2s ease;

      &.active {
        background: var(--color-henna, #4a231a);
        color: white;
      }
    }
  }
  // ====== CHANGE 4 END ======
  .booking {
    width: 100vw;
    overflow: hidden;
    min-height: 100vh;

    @include b-tablet {
      display: grid;
      grid: 1fr / 224px 1fr;
      gap: 3rem;
    }

    @include b-desktop {
      grid: 1fr / 280px 1fr;
    }

    @include b-large-desktop {
      grid: 1fr / 300px 1fr;
      gap: 6rem;
    }
  }

  .booking-intro {
    background: var(--color-marble);
    padding: 2rem 1rem 2rem;
    position: relative;

    @include b-tablet {
      padding: 3rem 1rem 2rem 2rem;

      &::before {
        content: "";
        display: block;
        position: absolute;
        background: inherit;
        top: -1rem;
        bottom: -1rem;
        clip-path: url(#wave6);
        width: 3rem;
        height: calc(100% + 1rem);
        left: auto;
        right: calc(-3rem + 1px);
      }
    }
  }

  .booking-types {
    scroll-margin-top: 1rem;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;

    @include b-desktop {
      gap: 1rem;
    }
  }

  .booking-options-toggle {
    &[aria-expanded="true"] {
      background-color: var(--color-henna);
      color: var(--color-marble);
    }
  }

  .booking-main {
    width: 100%;
    padding-bottom: 2rem;

    @include b-desktop {
      padding-top: 1.5rem;
    }
  }

  .booking-form {
    border: none;
  }
</style>
