---
import Layout from "../../layouts/default.astro";
import Header from "../../components/header.astro";
import Button from "../../components/button.astro";
import BookingOptions from "../../components/booking/options.astro";

import { frontmatter as config } from "../../../admin/pages/booking/booking.mdx";

const tours = Object.values(
  import.meta.glob("../../../admin/pages/booking/tours/*.mdx", { eager: true }),
);
// ====== UPDATED CHANGE 1: Foolproof city filtering ======
const allRental = Object.values(
  import.meta.glob("../../../admin/pages/booking/rental/*.mdx", { eager: true }),
);

// .toLowerCase() fixes capital letters like 'Marrakech'
// .trim() removes any accidental hidden spaces
const marrakechBikes = allRental.filter(bike => bike.frontmatter.city?.toLowerCase().trim() === 'marrakech');
const agadirBikes = allRental.filter(bike => bike.frontmatter.city?.toLowerCase().trim() === 'agadir');
// ====== CHANGE 1 END ======
---

<Layout pageTitle="Bookings" gtags={["AW-16465322938"]}>
  <Header cafe border />
  <div id="booking" class="booking">
    <aside class="booking-intro">
      <h2>I'd like to</h2>
      <nav class="booking-types">
        <Button
          class="booking-options-toggle"
          size="l"
          variant="outline"
          aria-controls="tours"
          aria-haspopup="true"
          aria-expanded="true"
        >
          Book a tour
        </Button>
        <Button
          class="booking-options-toggle"
          size="l"
          variant="outline"
          aria-controls="bike-rental"
          aria-haspopup="true"
        >
          Rent a bike
        </Button>
      </nav>
    </aside>
    <main class="booking-main">
      <BookingOptions
        id="tours"
        description={config["tours_description"]}
        items={tours}
        type="tour"
        preselected
      />
    {/* ====== UPDATED CHANGE 2: Pure Astro layout to prevent blank pages ====== */}
      <div id="bike-rental" hidden>
        <p class="rental-description" style="margin-bottom: 2rem;">{config["rental_description"]}</p>
        
        <h3 style="font-size: 1.5rem; margin: 2rem 0 1rem; color: var(--color-henna, #4a231a); border-bottom: 2px solid var(--color-marble); padding-bottom: 0.5rem;">
          🚲 Rentals in Marrakech
        </h3>
        <BookingOptions
          items={marrakechBikes}
          type="bikes"
        />

        <h3 style="font-size: 1.5rem; margin: 3rem 0 1rem; color: var(--color-henna, #4a231a); border-bottom: 2px solid var(--color-marble); padding-bottom: 0.5rem;">
          🚲 Rentals in Agadir
        </h3>
        <BookingOptions
          items={agadirBikes}
          type="bikes"
        />
      </div>
      {/* ====== END OF UPDATED CHANGE 2 ====== */}
    </main>
  </div>
</Layout>

<script>
  import setupBookingSelectable from "../../components/booking/booking-selectable";

  setupBookingSelectable({
    container: document.getElementById("booking"),
    optionsClass: "booking-intro",
    selectedClass: "booking-options-selected",
    toggleClass: "booking-options-toggle",
  });
//// ====== UPDATED CHANGE 3: Standard browser switching logic ======
  const cityButtons = document.querySelectorAll('.city-btn');
  const cityPanes = document.querySelectorAll('.city-pane');

  cityButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      // 1. Swap active button classes
      cityButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // 2. Safely toggle block vs none display
      cityPanes.forEach(pane => {
        if (pane.id === targetId) {
          pane.style.display = 'block';
        } else {
          pane.style.display = 'none';
        }
      });
    });
  });
  // ====== CHANGE 3 END ======
</script>

<style lang="scss">
  @import "../../styles/breakpoints";
  // ====== CHANGE 4 START: Styling rounded custom city buttons ======
  .city-switcher {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
    
    .city-btn {
      padding: 0.6rem 2rem;
      border-radius: 25px;
      border: 2px solid var(--color-henna, #4a231a);
      background: transparent;
      font-weight: bold;
      cursor: pointer;
      font-size: 1.1rem;
      transition: all 0.2s ease;

      &.active {
        background: var(--color-henna, #4a231a);
        color: white;
      }
    }
  }
  // ====== CHANGE 4 END ======
  .booking {
    width: 100vw;
    overflow: hidden;
    min-height: 100vh;

    @include b-tablet {
      display: grid;
      grid: 1fr / 224px 1fr;
      gap: 3rem;
    }

    @include b-desktop {
      grid: 1fr / 280px 1fr;
    }

    @include b-large-desktop {
      grid: 1fr / 300px 1fr;
      gap: 6rem;
    }
  }

  .booking-intro {
    background: var(--color-marble);
    padding: 2rem 1rem 2rem;
    position: relative;

    @include b-tablet {
      padding: 3rem 1rem 2rem 2rem;

      &::before {
        content: "";
        display: block;
        position: absolute;
        background: inherit;
        top: -1rem;
        bottom: -1rem;
        clip-path: url(#wave6);
        width: 3rem;
        height: calc(100% + 1rem);
        left: auto;
        right: calc(-3rem + 1px);
      }
    }
  }

  .booking-types {
    scroll-margin-top: 1rem;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;

    @include b-desktop {
      gap: 1rem;
    }
  }

  .booking-options-toggle {
    &[aria-expanded="true"] {
      background-color: var(--color-henna);
      color: var(--color-marble);
    }
  }

  .booking-main {
    width: 100%;
    padding-bottom: 2rem;

    @include b-desktop {
      padding-top: 1.5rem;
    }
  }

  .booking-form {
    border: none;
  }
</style>
